<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - بوابة تصاريح البناء</title>

    <!-- Bootstrap RTL -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

    <!-- PWA Meta Tags for Mobile -->
    <meta name="theme-color" content="#d4af37">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="apple-touch-icon" href="~/images/logo2.png">

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/x-icon" href="/images/logo7.jpeg" />
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</head>
<body>
    <!-- Enhanced Mobile-First Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg bp-navbar">
            <div class="container-fluid px-3">
                <!-- Brand -->
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo7.jpeg" alt="لوجو" width="40" height="40" class="ms-2">
                    <span class="d-none d-md-inline">بوابة تصاريح البناء</span>
                    <span class="d-md-none">التصاريح</span>
                </a>

                <!-- Mobile Notifications & User Menu -->
                <div class="d-flex align-items-center d-lg-none">
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <!-- Mobile Notification Bell -->
                        <div class="dropdown me-2">
                            <button class="btn btn-link p-1 position-relative" type="button" data-bs-toggle="dropdown">
                                <i class="fas fa-bell text-secondary"></i>
                                <span id="MobileNotificationBadge" class="badge bg-danger position-absolute top-0 start-100 translate-middle" style="display:none; font-size: 0.65rem;">0</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end" style="min-width: 280px;">
                                <h6 class="dropdown-header">الإشعارات</h6>
                                <div id="MobileNotificationList" class="text-secondary p-2">جاري التحميل...</div>
                                <div class="dropdown-divider"></div>
                                <a asp-controller="Notification" asp-action="GetAllNotifications" class="dropdown-item text-center">
                                    <i class="fas fa-list ms-1"></i> عرض الكل
                                </a>
                            </div>
                        </div>
                    }

                    <!-- Mobile Toggler -->
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>

                <!-- Main Navigation -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <!-- Main Menu Items -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home"></i>
                                <span class="ms-1">الرئيسية</span>
                            </a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <!-- Admin Menu -->
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-cogs"></i>
                                        <span class="ms-1">الإدارة</span>
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Users">
                                                <i class="fas fa-users"></i> المستخدمون
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Client" asp-action="Index">
                                                <i class="fas fa-file-alt"></i> الرخص
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Permit" asp-action="Archieve">
                                                <i class="fas fa-archive"></i> الأرشيف
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Permit" asp-action="fulfilments">
                                                <i class="fas fa-archive"></i> الاستيفاء
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <!-- Financial Menu -->
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-dollar-sign"></i>
                                        <span class="ms-1">المالية</span>
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Expense" asp-action="Index">
                                                <i class="fas fa-calculator"></i> الحسابات
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Cost" asp-action="Index">
                                                <i class="fas fa-money-bill"></i> المصروفات
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="GeneralCost" asp-action="Index">
                                                <i class="fas fa-money-bill"></i>  المصروفات العامة
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <!-- Reports & Notifications (Desktop) -->
                                <li class="nav-item dropdown d-none d-lg-block">
                                    <a class="nav-link position-relative" href="#" id="AdminNotificationsDropdown" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-bell"></i>
                                        <span id="AdminNotificationBadge" class="badge bg-danger position-absolute top-0 start-100 translate-middle" style="display:none;">0</span>
                                        <span class="ms-2">الإشعارات</span>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <h6 class="dropdown-header">الإشعارات الجديدة</h6>
                                        <div id="AdminNotificationList" class="text-secondary p-2">جاري التحميل...</div>
                                        <div class="dropdown-divider"></div>
                                        <a asp-controller="Notification" asp-action="GetAllNotifications" class="dropdown-item text-center">
                                            <i class="fas fa-list ms-1"></i> عرض جميع الإشعارات
                                        </a>
                                    </div>
                                </li>

                                <li class="nav-item dropdown d-none d-lg-block">
                                    <a class="nav-link position-relative" href="#" id="ReportNotificationsDropdown" role="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-chart-bar"></i>
                                        <span id="ReportNotificationBadge" class="badge bg-info position-absolute top-0 start-100 translate-middle" style="display:none;">0</span>
                                        <span class="ms-2">التقارير</span>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <h6 class="dropdown-header">تقارير النظام</h6>
                                        <div id="ReportNotificationList" class="text-secondary p-2">جاري التحميل...</div>
                                        <div class="dropdown-divider"></div>
                                        <a asp-controller="Report" asp-action="Index" class="dropdown-item text-center">
                                            <i class="fas fa-list ms-1"></i> عرض جميع التقارير
                                        </a>
                                    </div>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item" asp-controller="Client" asp-action="Index">
                                    <i class="fas fa-file-alt"></i> الرخص
                                </a>
                                
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="GeneralCost" asp-action="Create">
                                    <i class="fas fa-money-bill"></i> إضافة مصروف عام
                                </a>
                            </li>
                            <!-- User Profile -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle"></i>
                                    <span class="ms-1 d-none d-md-inline">@User.Claims.FirstOrDefault(x => x.Type == "Username")?.Value</span>
                                    <span class="ms-1 d-md-none">الملف الشخصي</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><h6 class="dropdown-header">مرحباً @User.Claims.FirstOrDefault(x => x.Type == "Username")?.Value</h6></li>
                                    <li><hr class="dropdown-divider"></li>
                                    
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fas fa-sign-out-alt"></i>
                                                <span class="ms-1">تسجيل الخروج</span>
                                            </button>
                                        </form>
                                    </li>

                                </ul>

                            </li>
                          
                        }
                        else
                        {
                            <!-- Guest User -->
                            <li class="nav-item">
                                <a class="nav-link bp-btn bp-btn-primary" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt"></i>
                                    <span class="ms-1">تسجيل الدخول</span>
                                </a>
                            </li>
                          
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="container-fluid py-3">
        @RenderBody()
        <script>
            $(document).ready(function () {
                // Enhanced form submission handler with remote validation support
                $("form").each(function () {
                    var form = $(this);
                    var isSubmitting = false;
                    var pendingSubmit = false;

                    // Override the default submitHandler for jQuery Validation
                    var validator = form.data('validator');
                    if (validator) {
                        // Store original submitHandler if exists
                        var originalSubmitHandler = validator.settings.submitHandler;

                        validator.settings.submitHandler = function (form, event) {
                            if (isSubmitting) {
                                if (event) event.preventDefault();
                                return false;
                            }

                            isSubmitting = true;
                            disableSubmitButtons($(form));

                            // Call original submit handler if it exists
                            if (originalSubmitHandler) {
                                originalSubmitHandler.call(this, form, event);
                            } else {
                                form.submit();
                            }
                        };
                    }

                    // Regular submit event handler
                    form.on("submit", function (e) {
                        var validator = $(this).validate();

                        // If already submitting, prevent
                        if (isSubmitting) {
                            e.preventDefault();
                            return false;
                        }

                        // If there are pending remote validations
                        if (validator.pendingRequest > 0) {
                            e.preventDefault();
                            pendingSubmit = true;

                            // Show waiting message (optional)
                            showValidationWaitingMessage($(this));

                            // Wait for pending validations
                            waitForRemoteValidation($(this), validator);

                            return false;
                        }

                        // Check if form is valid
                        if (!$(this).valid()) {
                            e.preventDefault();
                            return false;
                        }

                        // All validations passed
                        isSubmitting = true;
                        disableSubmitButtons($(this));

                        return true;
                    });

                    function waitForRemoteValidation(form, validator) {
                        var maxWaitTime = 5000; // 5 seconds max wait
                        var startTime = Date.now();

                        var checkInterval = setInterval(function () {
                            var elapsed = Date.now() - startTime;

                            // Timeout check
                            if (elapsed > maxWaitTime) {
                                clearInterval(checkInterval);
                                hideValidationWaitingMessage(form);
                                pendingSubmit = false;
                                alert("انتهى وقت التحقق. يرجى المحاولة مرة أخرى.");
                                return;
                            }

                            // Check if validation completed
                            if (validator.pendingRequest === 0) {
                                clearInterval(checkInterval);
                                hideValidationWaitingMessage(form);

                                if (pendingSubmit && form.valid()) {
                                    pendingSubmit = false;
                                    isSubmitting = true;
                                    disableSubmitButtons(form);

                                    // Remove submit handler temporarily and submit
                                    form.off('submit').submit();

                                    // Reattach handler after brief delay
                                    setTimeout(function () {
                                        form.on("submit", arguments.callee);
                                    }, 100);
                                } else {
                                    pendingSubmit = false;
                                }
                            }
                        }, 100);
                    }

                    function showValidationWaitingMessage(form) {
                        // Remove any existing message
                        form.find('.validation-waiting-msg').remove();

                        // Add waiting message near submit button
                        var $btns = form.find("button[type=submit], input[type=submit]");
                        if ($btns.length > 0) {
                            $btns.first().before(
                                '<div class="validation-waiting-msg alert alert-info py-2 mb-2">' +
                                '<i class="fas fa-spinner fa-spin"></i> جاري التحقق من البيانات...' +
                                '</div>'
                            );
                        }
                    }

                    function hideValidationWaitingMessage(form) {
                        form.find('.validation-waiting-msg').remove();
                    }

                    function disableSubmitButtons(form) {
                        var $btns = form.find("button[type=submit], input[type=submit]");

                        $btns.prop("disabled", true).addClass('btn-submitting');

                        $btns.each(function () {
                            var $btn = $(this);
                            if ($btn.is("button")) {
                                $btn.data("original-text", $btn.html());

                                var loadingHtml = '<span class="spinner-border spinner-border-sm me-2"></span>جاري الحفظ...';
                                $btn.html(loadingHtml);
                            } else if ($btn.is("input")) {
                                $btn.data("original-value", $btn.val());
                                $btn.val("جاري الحفظ...");
                            }
                        });

                        // Safety fallback: Re-enable after timeout
                        setTimeout(function () {
                            if (isSubmitting) {
                                resetSubmitButtons(form);
                                isSubmitting = false;
                                console.warn("Form submission timeout - buttons re-enabled");
                            }
                        }, 15000); // 15 seconds
                    }

                    function resetSubmitButtons(form) {
                        var $btns = form.find("button[type=submit], input[type=submit]");

                        $btns.prop("disabled", false).removeClass('btn-submitting');

                        $btns.each(function () {
                            var $btn = $(this);
                            if ($btn.is("button") && $btn.data("original-text")) {
                                $btn.html($btn.data("original-text"));
                            } else if ($btn.is("input") && $btn.data("original-value")) {
                                $btn.val($btn.data("original-value"));
                            }
                        });
                    }
                });

                // Handle browser back/forward button
                $(window).on('pageshow', function (event) {
                    if (event.originalEvent.persisted) {
                        $("form").each(function () {
                            var $btns = $(this).find("button[type=submit], input[type=submit]");
                            $btns.prop("disabled", false);
                        });
                    }
                });
            });
        </script>
    </main>

    <!-- Enhanced Footer -->
    <footer class="footer mt-auto">
        <div class="container text-center">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start">
                    <p class="mb-0">&copy; 2025 - بوابة تصاريح البناء</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none">
                        سياسة الخصوصية
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
       <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script src="~/js/printPDF.js"></script>

    <!-- Audio for notifications -->
    <audio id="notificationSound" preload="auto">
        <source src="~/sounds/sound1.wav" type="audio/wav">
        <source src="~/sounds/sound1.mp3" type="audio/mpeg">
    </audio>

    <!-- Notification Scripts -->
    <script>
        // Enhanced notification system with mobile support
        async function loadAdminNotifications() {
            try {
                let response = await fetch('/Notification/GetUnRead');
                let data = await response.json();

                // Update both desktop and mobile badges
                updateNotificationUI('AdminNotificationBadge', 'AdminNotificationList', data);
                updateNotificationUI('MobileNotificationBadge', 'MobileNotificationList', data);

                // Play sound for new notifications
                let previousCount = parseInt(localStorage.getItem('notificationCount')) || 0;
                if (data.count > previousCount && data.count > 0) {
                    playNotificationSound();
                    showNotificationToast(`لديك ${data.count} إشعار جديد`);
                }
                localStorage.setItem('notificationCount', data.count);

            } catch (err) {
                console.error('Error loading notifications:', err);
            }
        }

        async function loadAdminReports() {
            try {
                let response = await fetch('/Report/GetUnRead');
                let data = await response.json();

                updateReportUI('ReportNotificationBadge', 'ReportNotificationList', data);

            } catch (err) {
                console.error('Error loading reports:', err);
            }
        }

        function updateNotificationUI(badgeId, listId, data) {
            let badge = document.getElementById(badgeId);
            let list = document.getElementById(listId);

            if (!badge || !list) return;

            if (data.count > 0) {
                badge.textContent = data.count;
                badge.style.display = 'inline-block';
                badge.classList.add('animate__animated', 'animate__pulse');
            } else {
                badge.style.display = 'none';
            }

            if (data.notifications && data.notifications.length > 0) {
                list.innerHTML = '';
                data.notifications.slice(0, 5).forEach(n => {
                    let item = document.createElement('div');
                    item.className = 'dropdown-item-text border-bottom pb-2 mb-2';
                    item.innerHTML = `
                                <div class="d-flex align-items-start">
                                    <div class="flex-grow-1">
                                        <div class="fw-bold text-primary">${n.title || 'إشعار'}</div>
                                        <div class="text-secondary small">${n.message.substring(0, 50)}...</div>
                                        <div class="text-secondary small">${formatTimeAgo(n.createdAt)}</div>
                                    </div>
                                    <span class="badge bg-warning">جديد</span>
                                </div>
                            `;
                    list.appendChild(item);
                });

                if (data.notifications.length > 5) {
                    let moreItem = document.createElement('div');
                    moreItem.className = 'dropdown-item-text text-center text-secondary';
                    moreItem.textContent = `و ${data.notifications.length - 5} إشعار آخر...`;
                    list.appendChild(moreItem);
                }
            } else {
                list.innerHTML = '<div class="dropdown-item-text text-secondary text-center">لا توجد إشعارات جديدة</div>';
            }
        }

        function updateReportUI(badgeId, listId, data) {
            let badge = document.getElementById(badgeId);
            let list = document.getElementById(listId);

            if (!badge || !list) return;

            if (data.count > 0) {
                badge.textContent = data.count;
                badge.style.display = 'inline-block';
            } else {
                badge.style.display = 'none';
            }

            if (data.notifications && data.notifications.length > 0) {
                list.innerHTML = '';
                data.notifications.slice(0, 3).forEach(n => {
                    let item = document.createElement('div');
                    item.className = 'dropdown-item-text border-bottom pb-2 mb-2';
                    item.innerHTML = `
                                <div class="fw-bold text-info">تقرير جديد</div>
                                <div class="text-secondary small">${n.content.substring(0, 40)}...</div>
                            `;
                    list.appendChild(item);
                });
            } else {
                list.innerHTML = '<div class="dropdown-item-text text-secondary text-center">لا توجد تقارير جديدة</div>';
            }
        }

        function playNotificationSound() {
            let audio = document.getElementById('notificationSound');
            if (audio) {
                audio.play().catch(e => console.log('Could not play notification sound:', e));
            }
        }

        function showNotificationToast(message) {
            // Simple toast notification
            let toast = document.createElement('div');
            toast.className = 'position-fixed top-0 end-0 p-3';
            toast.style.zIndex = '9999';
            toast.innerHTML = `
                        <div class="toast show" role="alert">
                            <div class="toast-header">
                                <i class="fas fa-bell text-primary me-2"></i>
                                <strong class="me-auto">إشعار جديد</strong>
                                <button type="button" class="btn-close" onclick="this.closest('.toast').remove()"></button>
                            </div>
                            <div class="toast-body">${message}</div>
                        </div>
                    `;
            document.body.appendChild(toast);

            setTimeout(() => {
                toast.remove();
            }, 5000);
        }

        function formatTimeAgo(dateString) {
            let date = new Date(dateString);
            let now = new Date();
            let diff = now - date;
            let minutes = Math.floor(diff / 60000);

            if (minutes < 1) return 'الآن';
            if (minutes < 60) return `منذ ${minutes} دقيقة`;
            if (minutes < 1440) return `منذ ${Math.floor(minutes / 60)} ساعة`;
            return `منذ ${Math.floor(minutes / 1440)} يوم`;
        }

        // Initialize notifications for authenticated admin users
        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <text>
                // Load notifications on page load
                document.addEventListener('DOMContentLoaded', function () {
                    loadAdminNotifications();
                    loadAdminReports();
                });

            // Refresh every 30 seconds
            setInterval(loadAdminNotifications, 30000);
            setInterval(loadAdminReports, 45000);

            // Refresh when page becomes visible
            document.addEventListener('visibilitychange', function () {
                if (!document.hidden) {
                    loadAdminNotifications();
                    loadAdminReports();
                }
            });
            </text>
        }

            // Mobile navbar improvements
            document.addEventListener('DOMContentLoaded', function () {
                // Close mobile menu when clicking outside
                document.addEventListener('click', function (e) {
                    let navbar = document.getElementById('navbarNav');
                    let toggler = document.querySelector('.navbar-toggler');

                    if (navbar && navbar.classList.contains('show') &&
                        !navbar.contains(e.target) &&
                        !toggler.contains(e.target)) {

                        let bsCollapse = bootstrap.Collapse.getInstance(navbar);
                        if (bsCollapse) {
                            bsCollapse.hide();
                        }
                    }
                });

                // Close dropdown when clicking menu items (mobile)
                document.querySelectorAll('.dropdown-item').forEach(item => {
                    item.addEventListener('click', function () {
                        let navbar = document.getElementById('navbarNav');
                        if (navbar && navbar.classList.contains('show')) {
                            let bsCollapse = bootstrap.Collapse.getInstance(navbar);
                            if (bsCollapse) {
                                bsCollapse.hide();
                            }
                        }
                    });
                });
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    <!-- jsPDF Core -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <!-- AutoTable Plugin (optional, for better tables) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script src="~/js/Amiri-Bold-normal.js"></script>


    <script src="~/js/printPDF.js"></script>
</body>
</html>