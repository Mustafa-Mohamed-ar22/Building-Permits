@model IEnumerable<Building_Permits.MVC.ViewModels.UserVM>

@{
    ViewData["Title"] = "المستخدمين";
}

<!-- Alerts -->
@if (TempData["ActivateUser"] != null)
{
    <div class="bp-alert bp-alert-success">@TempData["ActivateUser"]</div>
}
else if (TempData["DeactivateUser"] != null)
{
    <div class="bp-alert bp-alert-success">@TempData["DeactivateUser"]</div>
}
else if (TempData["Register"] != null)
{
    <div class="bp-alert bp-alert-success">@TempData["Register"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-users"></i> إدارة المستخدمين</h2>

    <div class="d-flex gap-2">
        <a asp-action="CreateUser" asp-controller="Admin" class="bp-btn bp-btn-primary">
            <i class="fas fa-user-plus"></i> إضافة مستخدم جديد
        </a>
        @if (User.IsInRole("Admin"))
        {
            <button type="button" class="bp-btn bp-btn-primary" onclick="printPDF()">
                <i class="fas fa-print"></i> طباعة
            </button>
        }
    </div>
</div>


<!-- Search -->
<div class="mb-3">
    <input type="text" id="search" class="bp-form-control" placeholder="🔍 ابحث عن مستخدم..." />
</div>

<!-- Results -->
<div id="searchresult">
    @Html.Partial("_UserTable", Model)
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $("#search").on("keyup", function () {
                var query = $(this).val();

                $.ajax({
                    url: "/Admin/searchUsers",
                    type: "GET",
                    data: { q: query },
                    success: function (result) {
                        $("#searchresult").html(result);
                    },
                    error: function () {
                        $("#searchresult").html("<p class='text-danger'>حدث خطأ أثناء البحث.</p>");
                    }
                });
            });
        });
    </script>
}
