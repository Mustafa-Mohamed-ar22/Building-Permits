@model Building_Permits.MVC.ViewModels.StageGroup1View

@{
    ViewData["Title"] = "المرحلة الأولى - إجراءات التصاريح";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" dir="rtl">
    <div class="row">
        <div class="col">
