@model Building_Permits.MVC.ViewModels.fulfilVM

@{
    ViewData["Title"] = "تمديد الاستيفاء";
}
<div class="container my-4">
<div class="bp-card">
    <div class="bp-card-header">
        <h3 class="bp-card-title">
            <i class="fas fa-calendar-plus"></i> تمديد الاستيفاء
        </h3>
    </div>

    <div class="bp-card-body">
        <form asp-action="ExtendFulfil" onsubmit="return confirm('هل أنت متأكد من تمديد الاستيفاء لهذا العميل؟');">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="bp-form-group d-none">
                <label asp-for="PermitId" class="bp-form-label"></label>
                <input asp-for="PermitId" class="bp-form-control" />
                <span asp-validation-for="PermitId" class="text-danger"></span>
            </div>

            <div class="bp-form-group">
                <label asp-for="ClientName" class="bp-form-label"></label>
                <input asp-for="ClientName" readonly class="bp-form-control" />
                <span asp-validation-for="ClientName" class="text-danger"></span>
            </div>

            <div class="bp-form-group">
                <label asp-for="Reason" class="bp-form-label"></label>
                <input asp-for="Reason" class="bp-form-control" />
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>

            <div class="bp-form-group">
                <label asp-for="RememberDate" class="bp-form-label"></label>
                <input asp-for="RememberDate" class="bp-form-control" />
                <span asp-validation-for="RememberDate" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="bp-btn bp-btn-primary">
                    <i class="fas fa-save"></i> حفظ
                </button>
                <a asp-action="Index" class="bp-btn bp-btn-outline">
                    ⬅ العودة للقائمة
                </a>
            </div>
        </form>
    </div>
</div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
