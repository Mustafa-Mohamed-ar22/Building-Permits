@model Building_Permits.MVC.ViewModels.UpdateStageGroup1View

@{
	ViewData["Title"] = "المرحلة الأولى - إجراءات التصاريح";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" dir="rtl">
	<div class="row">
		<div class="col">
			<div class="bp-card">
				<div class="bp-card-header">
					<h4 class="bp-card-title mb-0">
						<div class="bp-card-icon">
							<i class="fas fa-clipboard-list"></i>
						</div>
						المرحلة الأولى - إجراءات التصاريح
					</h4>
				</div>
				<div class="bp-card-body">
					<form asp-action="UpdateStageGroup1" method="post" enctype="multipart/form-data" id="stageForm">
						<div asp-validation-summary="All" class="text-danger"></div>
						@Html.AntiForgeryToken()
						<input asp-for="PermitId" hidden />
						<!-- استلام العقد والتوكيل -->
						<div class="bp-card mb-4">
							<div class="bp-card-header">
								<h5 class="bp-card-title">
									<div class="bp-card-icon">
										<i class="fas fa-file-contract"></i>
									</div>
									@Html.DisplayNameFor(m => m.ContractReceiveAndAutharization)
								</h5>
							</div>
							<div class="bp-card-body">
								<div class="row">
									@{
										if (User.IsInRole("Admin")|| Model.ContractReceiveAndAutharization == false || Model.permitStages.FirstOrDefault(x => x.StageId == 2).CompletedAt.Value.Date == DateTime.Today)
										{
											<div class="col-mobile-12 col-tablet-6 col-desktop-3">
												<div class="bp-form-group">
													<div class="d-flex align-items-center gap-2">
														<input type="checkbox" asp-for="ContractReceiveAndAutharization" class="form-check-input" />
														<label class="bp-form-label">تم</label>
													</div>
													<span asp-validation-for="ContractReceiveAndAutharization" class="text-danger"></span>
												</div>
											</div>
											<div class="col-mobile-12 col-tablet-6 col-desktop-3">
												<div class="bp-form-group">
													@Html.LabelFor(m => m.ContractReceiveAndAutharizationTranactionNumber, new { @class = "bp-form-label" })
													<input asp-for="ContractReceiveAndAutharizationTranactionNumber" class="bp-form-control" />
													<span asp-validation-for="ContractReceiveAndAutharizationTranactionNumber" class="text-danger"></span>
												</div>
											</div>
											<div class="col-mobile-12 col-tablet-6 col-desktop-3">
												<div class="bp-form-group">
													@Html.LabelFor(m => m.ContractReceiveAndAutharizationImage, new { @class = "bp-form-label" })
													@if (Model.ContractReceiveAndAutharization == true && Model.IsContractHasExistedImage)
													{
														<div class="mb-2">
															<a href="@Url.Action("GetFile", "Permit", new { permitId = Model.PermitId, stageId = 2 })" target="_blank" class="bp-btn bp-btn-outline">
																عرض الملف الحالى
															</a>
														</div>
														<input asp-for="IsContractHasExistedImage" value="true" hidden />
													}
													<input asp-for="ContractReceiveAndAutharizationImage" type="file" class="bp-form-control" accept=".pdf,.jpg,.jpeg,.png" />
													<span asp-validation-for="ContractReceiveAndAutharizationImage" class="text-danger"></span>
													<input asp-for="IsContractHasImage" type="hidden" value="false" />
												</div>
											</div>
											<div class="col-mobile-12 col-tablet-6 col-desktop-3">
												<div class="bp-form-group">
													@Html.LabelFor(m => m.ContractReceiveAndAutharizationNotes, new { @class = "bp-form-label" })
													@Html.TextAreaFor(m => m.ContractReceiveAndAutharizationNotes, new { @class = "bp-form-control", rows = "2" })
												</div>
											</div>
											<input asp-for="IsContractHasChanges" type="hidden" value="false" />
										}
										else
										{
											<div class="col-mobile-12 col-tablet-6 col-desktop-3">
												<div class="bp-form-group">
													<div class="d-flex align-items-center gap-2">
														<input type="checkbox" asp-for="ContractReceiveAndAutharization" disabled class="form-check-input" />
														<label class="bp-form-label">تم</label>
													</div>
													<span asp-validation-for="ContractReceiveAndAutharization" class="text-danger"></span>
												</div>
											</div>
											<div class="col-mobile-12 col-tablet-6 col-desktop-3">
												<div class="bp-form-group">
													@Html.LabelFor(m => m.ContractReceiveAndAutharizationTranactionNumber, new { @class = "bp-form-label" })
													<input asp-for="ContractReceiveAndAutharizationTranactionNumber" disabled class="bp-form-control" />
													<span asp-validation-for="ContractReceiveAndAutharizationTranactionNumber" class="text-danger"></span>
												</div>
											</div>
											<div class="col-mobile-12 col-tablet-6 col-desktop-3">
												<div class="bp-form-group">
													<label class="bp-form-label">تم رفع المستند مسبقا</label>
													<input asp-for="ContractReceiveAndAutharizationImage" type="file" disabled class="bp-form-control" accept=".pdf,.jpg,.jpeg,.png" />
												</div>
											</div>
											<div class="col-mobile-12 col-tablet-6 col-desktop-3">
												<div class="bp-form-group">
													@Html.LabelFor(m => m.ContractReceiveAndAutharizationNotes, new { @class = "bp-form-label" })
													<input asp-for="ContractReceiveAndAutharizationNotes" disabled class="bp-form-control" />
												</div>
											</div>
										}
									}
								</div>
							</div>
						</div>

						<!-- بيان الصلاحية -->
						@if (User.IsInRole("Admin") || Model.Validity == false || Model.permitStages.FirstOrDefault(x => x.StageId == 3).CompletedAt.Value.Date == DateTime.Today)
						{
							<div class="bp-card mb-4">
								<div class="bp-card-header">
									<h5 class="bp-card-title">
										<div class="bp-card-icon">
											<i class="fas fa-certificate"></i>
										</div>
										@Html.DisplayNameFor(m => m.Validity)
									</h5>
								</div>
								<div class="bp-card-body">
									<div class="row">
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												<div class="d-flex align-items-center gap-2">
													<input type="checkbox" asp-for="Validity" class="form-check-input" />
													<input name="Validity" type="hidden" value="false" />
													<label class="bp-form-label">تم</label>
												</div>
												<span asp-validation-for="Validity" class="text-danger"></span>
											</div>
										</div>
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												@Html.LabelFor(m => m.ValidityTranactionNumber, new { @class = "bp-form-label" })
												@Html.TextBoxFor(m => m.ValidityTranactionNumber, new { @class = "bp-form-control" })
												<span asp-validation-for="ValidityTranactionNumber" class="text-danger"></span>
											</div>
										</div>
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												@Html.LabelFor(m => m.ValidityImage, new { @class = "bp-form-label" })
												@if (Model.Validity == true || Model.IsValidityHasExistedImage)
												{
													<div class="mb-2">
														<a href="@Url.Action("GetFile", "Permit", new { permitId = Model.PermitId, stageId = 3 })" target="_blank" class="bp-btn bp-btn-outline">
															عرض الملف الحالى
														</a>
													</div>
													<input asp-for="IsValidityHasExistedImage" value="true" hidden />
												}
												<input asp-for="ValidityImage" type="file" class="bp-form-control" accept=".pdf,.jpg,.jpeg,.png" />
												<input asp-for="IsValidityHasImage" type="hidden" value="false" />
											</div>
										</div>
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												@Html.LabelFor(m => m.ValidityNotes, new { @class = "bp-form-label" })
												@Html.TextAreaFor(m => m.ValidityNotes, new { @class = "bp-form-control", rows = "2" })
											</div>
										</div>
									</div>

									<!-- Sub-items for Validity -->
									<div class="bp-card mt-3" style="background: rgba(59, 130, 246, 0.05); border: 1px solid var(--info);">
										<div class="bp-card-header p-3">
											<h6 class="bp-card-title mb-0" style="color: var(--info); font-size: 0.95rem;">
												<i class="fas fa-tasks"></i>
												الاستلامات الفرعية
											</h6>
										</div>
										<div class="bp-card-body p-3">
											<div class="row">
												<div class="col-mobile-12 col-tablet-4 col-desktop-4">
													<div class="d-flex align-items-center gap-2">
														<input type="checkbox" asp-for="EngineerReceive" class="form-check-input" value="true" />
														<input name="EngineerReceive" type="hidden" value="false" />
														@Html.LabelFor(m => m.EngineerReceive, new { @class = "bp-form-label mb-0" })
													</div>
												</div>
												<div class="col-mobile-12 col-tablet-4 col-desktop-4">
													<div class="d-flex align-items-center gap-2">
														<input type="checkbox" asp-for="TechReceive" class="form-check-input" value="true" />
														<input name="TechReceive" type="hidden" value="false" />
														@Html.LabelFor(m => m.TechReceive, new { @class = "bp-form-label mb-0" })
													</div>
												</div>
												<div class="col-mobile-12 col-tablet-4 col-desktop-4">
													<div class="d-flex align-items-center gap-2">
														<input type="checkbox" asp-for="ValidityReceive" class="form-check-input" value="true" />
														<input name="ValidityReceive" type="hidden" value="false" />
														@Html.LabelFor(m => m.ValidityReceive, new { @class = "bp-form-label mb-0" })
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
								<input asp-for="IsValidityHasChanges" type="hidden" value="false" />
							</div>
						}
						else
						{
							<div class="bp-card mb-4">
								<div class="bp-card-header">
									<h5 class="bp-card-title">
										<div class="bp-card-icon">
											<i class="fas fa-certificate"></i>
										</div>
										@Html.DisplayNameFor(m => m.Validity)
									</h5>
								</div>
								<div class="bp-card-body">
									<div class="row">
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												<div class="d-flex align-items-center gap-2">
													<input type="checkbox" asp-for="Validity" disabled class="form-check-input" />
													<label class="bp-form-label">تم</label>
												</div>
												<span asp-validation-for="Validity" class="text-danger"></span>
											</div>
										</div>
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												@Html.LabelFor(m => m.ValidityTranactionNumber, new { @class = "bp-form-label" })
												<input asp-for="ValidityTranactionNumber" disabled class="bp-form-control" />
												<span asp-validation-for="ValidityTranactionNumber" class="text-danger"></span>
											</div>
										</div>
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												<label class="bp-form-label">تم رفع المستند مسبقا</label>
												<input asp-for="ValidityImage" type="file" disabled class="bp-form-control" accept=".pdf,.jpg,.jpeg,.png" />
											</div>
										</div>
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												@Html.LabelFor(m => m.ValidityNotes, new { @class = "bp-form-label" })
												<input asp-for="ValidityNotes" disabled class="bp-form-control" />
											</div>
										</div>
									</div>

									<!-- Disabled Sub-items for Validity -->
									<div class="bp-card mt-3" style="background: rgba(128, 128, 128, 0.05); border: 1px solid var(--border);">
										<div class="bp-card-header p-3">
											<h6 class="bp-card-title mb-0" style="color: var(--text-muted); font-size: 0.95rem;">
												<i class="fas fa-tasks"></i>
												الاستلامات الفرعية - مكتملة
											</h6>
										</div>
										<div class="bp-card-body p-3">
											<div class="row">
												<div class="col-mobile-12 col-tablet-4 col-desktop-4">
													<div class="d-flex align-items-center gap-2">
														<input type="checkbox" name="EngineerReceive" id="EngineerReceive" disabled class="form-check-input" value="true" checked />
														@Html.LabelFor(m => m.EngineerReceive, new { @class = "bp-form-label mb-0", @style = "color: var(--text-muted);" })
													</div>
												</div>
												<div class="col-mobile-12 col-tablet-4 col-desktop-4">
													<div class="d-flex align-items-center gap-2">
														<input type="checkbox" name="TechReceive" id="TechReceive" disabled class="form-check-input" value="true" checked />
														@Html.LabelFor(m => m.TechReceive, new { @class = "bp-form-label mb-0", @style = "color: var(--text-muted);" })
													</div>
												</div>
												<div class="col-mobile-12 col-tablet-4 col-desktop-4">
													<div class="d-flex align-items-center gap-2">
														<input type="checkbox" name="ValidityReceive" id="ValidityReceive" disabled class="form-check-input" value="true" checked />
														@Html.LabelFor(m => m.ValidityReceive, new { @class = "bp-form-label mb-0", @style = "color: var(--text-muted);" })
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						}
						<!-- الشئون القانونية -->
						@if (User.IsInRole("Admin") || Model.LegalAffairs == false || Model.permitStages.FirstOrDefault(x => x.StageId == 4).CompletedAt.Value.Date == DateTime.Today)
						{
							<div class="bp-card mb-4">
								<div class="bp-card-header">
									<h5 class="bp-card-title">
										<div class="bp-card-icon">
											<i class="fas fa-balance-scale"></i>
										</div>
										@Html.DisplayNameFor(m => m.LegalAffairs)
									</h5>
								</div>
								<div class="bp-card-body">
									<div class="row">
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												<div class="d-flex align-items-center gap-2">
													<input type="checkbox" asp-for="LegalAffairs" class="form-check-input" />
													<input name="LegalAffairs" type="hidden" value="false" />
													<label class="bp-form-label">تم</label>
												</div>
												<span asp-validation-for="LegalAffairs" class="text-danger"></span>
											</div>
										</div>
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												@Html.LabelFor(m => m.LegalAffairsTranactionNumber, new { @class = "bp-form-label" })
												@Html.TextBoxFor(m => m.LegalAffairsTranactionNumber, new { @class = "bp-form-control" })
												<span asp-validation-for="LegalAffairsTranactionNumber" class="text-danger"></span>
											</div>
										</div>
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												@Html.LabelFor(m => m.LegalAffairsImage, new { @class = "bp-form-label" })
												@if (Model.IsLegalHasExistedImage)
												{
													<div class="mb-2">
														<a href="@Url.Action("GetFile", "Permit", new { permitId = Model.PermitId, stageId = 4 })" target="_blank" class="bp-btn bp-btn-outline">
															عرض الملف الحالى
														</a>
													</div>
													<input asp-for="IsLegalHasExistedImage" value="true" hidden />
												}
												<input asp-for="LegalAffairsImage" type="file" class="bp-form-control" accept=".pdf,.jpg,.jpeg,.png" />
												<input asp-for="IsLegalAffairsHasImage" type="hidden" value="false" />
											</div>
										</div>
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												@Html.LabelFor(m => m.LegalAffairsNotes, new { @class = "bp-form-label" })
												@Html.TextAreaFor(m => m.LegalAffairsNotes, new { @class = "bp-form-control", rows = "2" })
											</div>
										</div>
									</div>
								</div>
								<input asp-for="IsLegalHasChanges" type="hidden" value="false" />
							</div>
						}
						else
						{
							<div class="bp-card mb-4">
								<div class="bp-card-header">
									<h5 class="bp-card-title">
										<div class="bp-card-icon">
											<i class="fas fa-balance-scale"></i>
										</div>
										@Html.DisplayNameFor(m => m.LegalAffairs)
									</h5>
								</div>
								<div class="bp-card-body">
									<div class="row">
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												<div class="d-flex align-items-center gap-2">
													<input type="checkbox" asp-for="LegalAffairs" disabled class="form-check-input" />
													<label class="bp-form-label">تم</label>
												</div>
												<span asp-validation-for="LegalAffairs" class="text-danger"></span>
											</div>
										</div>
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												@Html.LabelFor(m => m.LegalAffairsTranactionNumber, new { @class = "bp-form-label" })
												<input asp-for="LegalAffairsTranactionNumber" disabled class="bp-form-control" />
												<span asp-validation-for="LegalAffairsTranactionNumber" class="text-danger"></span>
											</div>
										</div>
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												<label class="bp-form-label">تم رفع المستند مسبقا</label>
												<input asp-for="LegalAffairsImage" type="file" disabled class="bp-form-control" accept=".pdf,.jpg,.jpeg,.png" />
											</div>
										</div>
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												@Html.LabelFor(m => m.LegalAffairsNotes, new { @class = "bp-form-label" })
												<input asp-for="LegalAffairsNotes" disabled class="bp-form-control" />
											</div>
										</div>
									</div>
								</div>
							</div>
						}


						<!-- الرفع المساحى -->
						@if (User.IsInRole("Admin") || Model.Surveying == false || Model.permitStages.FirstOrDefault(x => x.StageId == 5).CompletedAt.Value.Date == DateTime.Today)
						{
							<div class="bp-card mb-4">
								<div class="bp-card-header">
									<h5 class="bp-card-title">
										<div class="bp-card-icon">
											<i class="fas fa-balance-scale"></i>
										</div>
										@Html.DisplayNameFor(m => m.Surveying)
									</h5>
								</div>
								<div class="bp-card-body">
									<div class="row">
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												<div class="d-flex align-items-center gap-2">
													<input type="checkbox" asp-for="Surveying" class="form-check-input" />
													<input name="Surveying" type="hidden" value="false" />
													<label class="bp-form-label">تم</label>
												</div>
												<span asp-validation-for="Surveying" class="text-danger"></span>
											</div>
										</div>
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												@Html.LabelFor(m => m.SurveyingTranactionNumber, new { @class = "bp-form-label" })
												@Html.TextBoxFor(m => m.SurveyingTranactionNumber, new { @class = "bp-form-control" })
												<span asp-validation-for="SurveyingTranactionNumber" class="text-danger"></span>
											</div>
										</div>
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												@Html.LabelFor(m => m.SurveyingImage, new { @class = "bp-form-label" })
												@if (Model.Surveying == true || Model.IsSurveyingHasExistedImage)
												{
													<div class="mb-2">
														<a href="@Url.Action("GetFile", "Permit", new { permitId = Model.PermitId, stageId = 5 })" target="_blank" class="bp-btn bp-btn-outline">
															عرض الملف الحالى
														</a>
													</div>
													<input asp-for="IsSurveyingHasExistedImage" value="true" hidden />
												}
												<input asp-for="SurveyingImage" type="file" class="bp-form-control" accept=".pdf,.jpg,.jpeg,.png" />
												<input asp-for="IsSurveyingHasImage" type="hidden" value="false" />
											</div>
										</div>
										<div class="col-mobile-12 col-tablet-6 col-desktop-3">
											<div class="bp-form-group">
												@Html.LabelFor(m => m.SurveyingNotes, new { @class = "bp-form-label" })
												@Html.TextAreaFor(m => m.SurveyingNotes, new { @class = "bp-form-control", rows = "2" })
											</div>
										</div>
									</div>
								</div>
								<input asp-for="IsSurveyingHasChanges" type="hidden" value="false" />
							</div>
						}
						else
						{
							<div class="bp-card mb-4">
								<div class="bp-card-header">
									<h5 class="bp-card-title">
										<div class="bp-card-icon">
											<i class="fas fa-balance-scale"></i>
										</div>
										@Html.DisplayNameFor(m => m.Surveying)
									</h5>
								</div>
								<div class="bp-card-body">
