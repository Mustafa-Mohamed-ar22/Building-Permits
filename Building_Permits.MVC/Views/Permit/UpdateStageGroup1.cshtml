				}
			});
		};

		// Bind to change events on all relevant inputs
		$('[name="Validity"], [name="ValidityReceive"], [name="TechReceive"], [name="EngineerReceive"], [name="IsValidityHasImage"], [name="ValidityTranactionNumber"], [name="IsValidityHasExistedImage"]').on('change keyup input blur click', runValidityValidation);


		// LegalAffairs validation
