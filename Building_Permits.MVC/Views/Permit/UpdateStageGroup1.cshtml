					if ($('[name="FinishingFile"]').is(':disabled')) {
		isValidLegal = true;
		return;
	}
			var currentState = $('[name="FinishingFile"]').is(':checked');
			console.log('FinishingFile checkbox changed from', originalFinishingFileState, 'to', currentState);

			var data = {
				FinishingFile: currentState,
				IsFinishingFileHasImage: $('[name="IsFinishingFileHasImage"]').val() === 'true',
				FinishingFileTranactionNumber: $('[name="FinishingFileTranactionNumber"]').val(),
				IsFinishingHasExistedImage: $('[name="IsFinishingHasExistedImage"]').val() === 'true'
			};

			$.get('/Remote/isValidFinishingFile2', data).done(function (response) {
				console.log('FinishingFile remote validation response:', response);
				var errorSpan = $('[data-valmsg-for="FinishingFile"]');
				if (response === true) {
					isValidFinish = true;
					errorSpan.text('').removeClass('field-validation-error').addClass('field-validation-valid');
				} else if (typeof response === 'string') {
					isValidFinish = false;
					errorSpan.text(response).removeClass('field-validation-valid').addClass('field-validation-error');
				} else {
					isValidFinish = false;
					errorSpan.text('من فضلك أرفق رقم المعاملة وصورة من إيصال تقديم الملف').removeClass('field-validation-valid').addClass('field-validation-error');
				}
			});
		}
		$('[name="FinishingFile"], [name="IsFinishingFileHasImage"], [name="FinishingFileTranactionNumber"], [name="IsFinishingHasExistedImage"]').on('change keyup input blur click', FinishingValidation);

		$('#stageForm').on('submit', function (e) {
