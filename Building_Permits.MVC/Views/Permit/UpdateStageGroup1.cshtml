@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
	<script>
		
		let isValidContract = $('[name="ContractReceiveAndAutharization"]').is(':disabled') || !$('[name="ContractReceiveAndAutharization"]').is(':checked');
		let isValidValidity = $('[name="Validity"]').is(':disabled') || !$('[name="Validity"]').is(':checked');
		let isValidLegal = $('[name="LegalAffairs"]').is(':disabled') || !$('[name="LegalAffairs"]').is(':checked');
		let isValidSurv = $('[name="Surveying"]').is(':disabled') || !$('[name="Surveying"]').is(':checked');
		let isValidComplete = $('[name="CompletingFile"]').is(':disabled') || !$('[name="CompletingFile"]').is(':checked');
		let isValidFinish = $('[name="FinishingFile"]').is(':disabled') || !$('[name="FinishingFile"]').is(':checked');

		function debounce(func, wait) {
			let timeout;
			return function () {
				clearTimeout(timeout);
				timeout = setTimeout(() => func.apply(this, arguments), wait);
			};
		}


		$(document).ready(function () {
			const fileInputs = [
				{ input: 'ContractReceiveAndAutharizationImage', hidden: 'IsContractHasImage' },
				{ input: 'ValidityImage', hidden: 'IsValidityHasImage' },
				{ input: 'LegalAffairsImage', hidden: 'IsLegalAffairsHasImage' },
				{ input: 'SurveyingImage', hidden: 'IsSurveyingHasImage' },
				{ input: 'CompletingFileImage', hidden: 'IsCompletingFileHasImage' },
				{ input: 'FinishingFileImage', hidden: 'IsFinishingFileHasImage' }
			];

			fileInputs.forEach(item => {
				const fileInput = document.getElementById(item.input);
				const hiddenField = document.getElementById(item.hidden);
				if (fileInput && hiddenField) {
					fileInput.addEventListener('change', function () {
						hiddenField.value = fileInput.files.length > 0 ? 'true' : 'false';
						console.log(hiddenField.value);
						$(hiddenField).trigger('change');
					});
				}
			});
		});

		// Store original states
		var originalContractState = $('[name="ContractReceiveAndAutharization"]:checkbox').is(':checked');
		var originalValidityState = $('[name="Validity"]:checkbox').is(':checked');
		var originalLegalAffairsState = $('[name="LegalAffairs"]:checkbox').is(':checked');
		var originalSurveyingState = $('[name="Surveying"]:checkbox').is(':checked');
		var originalCompletingFileState = $('[name="CompletingFile"]:checkbox').is(':checked');
		var originalFinishingFileState = $('[name="FinishingFile"]:checkbox').is(':checked');

		// ContractReceiveAndAutharization validation
		var runContractValidation = function () {
			if ($('[name="ContractReceiveAndAutharization"]').is(':disabled')) {
				isValidContract = true;
				return;
			}

			var currentState = $('[name="ContractReceiveAndAutharization"]').is(':checked');
			console.log('Contract checkbox changed from', originalContractState, 'to', currentState);

			var data = {
				ContractReceiveAndAutharization: currentState,
				IsContractHasImage: $('[name="IsContractHasImage"]').val() === 'true',
				ContractReceiveAndAutharizationTranactionNumber: $('[name="ContractReceiveAndAutharizationTranactionNumber"]').val(),
				IsContractHasExistedImage: $('[name="IsContractHasExistedImage"]').val() === 'true'
			};

			$.get('/Remote/isValidContract2', data).done(function (response) {
				console.log('Contract remote validation response:', response);
				var errorSpan = $('[data-valmsg-for="ContractReceiveAndAutharization"]');
				if (response === true) {
					isValidContract = true;
					errorSpan.text('').removeClass('field-validation-error').addClass('field-validation-valid');
				} else if (typeof response === 'string') {
					isValidContract = false;
					errorSpan.text(response).removeClass('field-validation-valid').addClass('field-validation-error');
				} else {
					isValidContract = false;
					errorSpan.text('من فضلك أرفق رقم المعاملة وصورة العقد والتوكيل').removeClass('field-validation-valid').addClass('field-validation-error');
				}
			});
		}
		$('[name="ContractReceiveAndAutharization"], [name="IsContractHasImage"], [name="ContractReceiveAndAutharizationTranactionNumber"], [name="IsContractHasExistedImage"]').on('change keyup input blur click', runContractValidation);




		var runValidityValidation = function () {
			if ($('[name="Validity"]').is(':disabled')) {
				isValidValidity = true;
				return;
			}
			var currentState = $('[name="Validity"]').is(':checked');

			var data = {
				Validity: currentState,
				ValidityReceive: $('[name="ValidityReceive"]').is(':checked'),
				TechReceive: $('[name="TechReceive"]').is(':checked'),
				EngineerReceive: $('[name="EngineerReceive"]').is(':checked'),
				IsValidityHasImage: $('[name="IsValidityHasImage"]').val() === 'true',
				ValidityTranactionNumber: $('[name="ValidityTranactionNumber"]').val(),
				IsValidityHasExistedImage: $('[name="IsValidityHasExistedImage"]').val() === 'true',
				PermitId: $('[name="PermitId"]').val()
			};

			$.get('/Remote/isValidValidity2', data).done(function (response) {
