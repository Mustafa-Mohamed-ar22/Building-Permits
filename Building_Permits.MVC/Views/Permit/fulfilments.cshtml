@model IEnumerable<Building_Permits.MVC.ViewModels.fulfilDisplayVM>
@{
    ViewData["Title"] = "الاستيفاءات";
}

@if (TempData["fulfil"] != null)
{
    <div class="bp-alert bp-alert-success">@TempData["fulfil"]</div>
}
else if (TempData["deletefulfil"] != null)
{
    <div class="bp-alert bp-alert-success">@TempData["deletefulfil"]</div>
}
else if (TempData["extendfulfil"] != null)
{
    <div class="bp-alert bp-alert-success">@TempData["extendfulfil"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-tasks"></i> الاستيفاءات</h2>

    <button type="button" class="bp-btn bp-btn-primary" onclick="printPDF()">
        <i class="fas fa-print"></i> طباعة
    </button>
</div>
<div class="printPDF">
    <div class="mt-3">
        <table class="bp-table-responsive">
        <thead>
            <tr>
                <th>اسم العميل</th>
                <th>تاريخ توقف الرخصة</th>
                <th>موعد التذكير</th>
                <th>السبب</th>
                <th class="no-print">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                        <td data-label="العميل">@Html.DisplayFor(modelItem => item.clientName)</td>
                        <td data-label="تاريخ توقف الرخصة">@Html.DisplayFor(modelItem => item.pausedAt)</td>
                        <td data-label="موعد التذكير">@Html.DisplayFor(modelItem => item.rememberDate)</td>
                    <td data-label="السبب">@Html.DisplayFor(modelItem => item.fulfilReason)</td>
                    <td data-label="الإجراءات" class="d-flex gap-2 no-print">
                        <a class="bp-btn bp-btn-outline"
                           onclick="return confirm('هل أنت متأكد من تمديد الاستيفاء؟');"
                           asp-action="ExtendFulfil" asp-controller="Permit" asp-route-id="@item.PermitId">
                            <i class="fas fa-calendar-plus"></i> تمديد
                        </a>

                        <form asp-action="DeleteFormFulfil" asp-controller="Permit" asp-route-id="@item.PermitId"
                              method="post"
                              onsubmit="return confirm('هل أنت متأكد من حذف الرخصة من الاستيفاء واستكمالها بشكل طبيعى؟');">
                            <button type="submit" class="bp-btn bp-btn-outline">
                                <i class="fas fa-undo"></i> حذف من الاستيفاء
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>