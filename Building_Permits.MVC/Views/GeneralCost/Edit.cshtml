@model Building_Permits.MVC.ViewModels.GeneralCostVM

@{
    ViewData["Title"] = "تعديل المصروف";
}

<div class="bp-card">
    <div class="bp-card-header">
        <h3 class="bp-card-title">
            <i class="fas fa-edit"></i> تعديل المصروف
        </h3>
    </div>

    <div class="bp-card-body">
        <form asp-action="Edit" onsubmit="return confirm('هل أنت متأكد من حفظ التعديلات؟');">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="bp-form-group">
                <label asp-for="Amount" class="bp-form-label"></label>
                <input asp-for="Amount" class="bp-form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="bp-form-group">
                <label asp-for="AmountFor" class="bp-form-label"></label>
                <input asp-for="AmountFor" class="bp-form-control" />
                <span asp-validation-for="AmountFor" class="text-danger"></span>
            </div>

            <div class="bp-form-group d-none">
                <label asp-for="Id" class="bp-form-label"></label>
                <input asp-for="Id" class="bp-form-control" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="bp-btn bp-btn-primary">
                    <i class="fas fa-save"></i> حفظ
                </button>
                <a asp-action="Index" class="bp-btn bp-btn-outline">
                    ⬅ العودة للقائمة
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
