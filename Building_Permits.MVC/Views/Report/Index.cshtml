@model IEnumerable<Building_Permits.Core.Entities.Report>

@{
    ViewData["Title"] = "التقارير";
}

<h2 class="mb-3">📊 التقارير</h2>

<div class="bp-table-responsive">
    <table class="bp-table">
        <thead>
            <tr>
                <th class="text-center">العنوان</th>
                <th class="text-center">الفترة</th>
                <th class="text-center">تاريخ الإنشاء</th>
                <th class="text-center">الحالة</th>
                <th class="text-center">التفاصيل</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var report in Model)
            {
                <tr class="@(report.IsRead ? "" : "bp-alert-error")">
                    <td class="text-center">@report.Title</td>
                    <td class="text-center">@report.Period</td>
                    <td class="text-center">@report.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-center">
                        @if (report.HasCriticalIssues)
                        {
                            <span class="badge bp-alert-error">⚠️ مشاكل حرجة</span>
                        }
                        else
                        {
                            <span class="badge bp-alert-success">✔️ لا يوجد مشاكل</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-controller="Report" asp-action="Details" asp-route-id="@report.Id"
                           class="bp-btn bp-btn-outline">
                            <i class="fas fa-eye"></i> عرض
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
