@model IEnumerable<Building_Permits.MVC.ViewModels.PermitCostVm>

@{
    decimal x = 0;
}
<div class="table-responsive printPDF">
    <table class="bp-table" >
        <thead>
            <tr>
                <th >اسم العميل</th>
                <th class="text-center">تفاصيل المصاريف</th>
                <th >إجمالي المصاريف</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var permit in Model)
            {
                <tr>
                    <td><a asp-action="PermitCosts" asp-controller="Cost" asp-route-id="@permit.PermitId" asp-route-ClientName="@permit.clientName">@permit.clientName</a></td>
                    <td>
                        <div class="table-responsive printPDF">
                            <table class="bp-table bp-table-nested">
                                <thead>
                                    <tr>
                                        <th>الوصف</th>
                                        <th>المبلغ</th>
                                        <th>تاريخ الإضافة</th>
                                        <th>المهندس</th>
                                        <th>تعديل</th>
                                        <th>حذف</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cost in permit.permitcosts)
                                    {
                                        <tr>
                                            <td>@cost.AmountFor</td>
                                            <td>@cost.Amount ج.م</td>
                                            <td>@(cost.AddedAt?.ToString("yyyy/MM/dd HH:mm") ?? "غير محدد")</td>
                                            <td>@cost.AddedBy</td>
                                            <td>
                                                <a asp-action="edit" asp-controller="Cost" asp-route-costId="@cost.Id" asp-route-PermitId="@cost.PermitId">تعديل</a>
                                            </td>
                                            <td>
                                                <a onclick="return confirm('هل أنت متأكد من حذف المصروف؟');" asp-action="Delete" asp-controller="Cost" asp-route-costId="@cost.Id" asp-route-PermitId="@cost.PermitId">حذف</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </td>
                    <td>@permit.total ج.م</td>
                    @{
                        x += permit.total;
                    }
                  
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="bp-summary mt-3 text-warning">
    <strong>إجمالي المصاريف:</strong> @x ج.م
</div>

<style>
    .bp-table {
        font-size: 0.875rem; /* or 14px */
    }

    .bp-table-nested {
        font-size: 0.75rem; /* or 12px - even smaller for nested table */
    }

    .bp-table td,
    .bp-table th {
        padding: 0.375rem; /* default Bootstrap is usually 0.75rem */
    }

    .bp-table-nested td,
    .bp-table-nested th {
        padding: 0.25rem; /* even less for nested table */
    }
</style>