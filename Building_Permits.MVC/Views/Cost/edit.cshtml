@model Building_Permits.MVC.ViewModels.CostVM

@{
    ViewData["Title"] = "تعديل المصروف";
}

<div class="container my-4">
<div class="bp-card">
    <div class="bp-card-header">
        <h3 class="bp-card-title">
            <i class="fas fa-edit"></i> تعديل المصروف
        </h3>
    </div>

    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="bp-form-group">
            <label asp-for="Amount" class="bp-form-label"></label>
            <input asp-for="Amount" class="bp-form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>

        <div class="bp-form-group">
            <label asp-for="AmountFor" class="bp-form-label"></label>
            <input asp-for="AmountFor" class="bp-form-control" />
            <span asp-validation-for="AmountFor" class="text-danger"></span>
        </div>

        <div class="bp-form-group d-none">
            <label asp-for="PermitId" class="bp-form-label"></label>
            <input asp-for="PermitId" class="bp-form-control" />
            <span asp-validation-for="PermitId" class="text-danger"></span>
        </div>

        <div class="bp-form-group">
            <label asp-for="ClientName" class="bp-form-label"></label>
            <input asp-for="ClientName" readonly class="bp-form-control" />
            <span asp-validation-for="ClientName" class="text-danger"></span>
        </div>

        <div class="bp-form-group d-none">
            <label asp-for="CostId" class="bp-form-label"></label>
            <input asp-for="CostId" class="bp-form-control" />
            <span asp-validation-for="CostId" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
                <button type="submit" onclick="return confirm('هل أنت متأكد من صحة البيانات ؟');" class="bp-btn bp-btn-primary">
                <i class="fas fa-save"></i> حفظ
            </button>
                <a  asp-action="Index" asp-controller="Cost" class="bp-btn bp-btn-outline">
                ⬅ العودة للقائمة
            </a>
        </div>
    </form>
</div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
